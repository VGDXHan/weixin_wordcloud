{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "微信聊天词云",
  "version": "0.1.0",
  "identifier": "com.weixin.wordcloud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "微信聊天词云",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/wx_key.dll"]
  }
}
